  "flux-txt2img": {
    "description": "Flux 基础文生图 workflow",
    "name": "Flux Text to Image",
    "node_mapping": {
      "cfg": {
        "class_type": "FluxGuidance",
        "match_strategy": "unique_class",
        "widget": "guidance"
      },
      "ckpt_name": {
        "class_type": "CheckpointLoaderSimple",
        "match_strategy": "unique_class",
        "widget": "ckpt_name"
      },
      "clip_name": {
        "class_type": "CLIPLoader",
        "match_strategy": "unique_class",
        "widget": "clip_name"
      },
      "denoise": {
        "class_type": "BasicScheduler",
        "match_strategy": "unique_class",
        "widget": "denoise"
      },
      "dual_clip_name1": {
        "class_type": "DualCLIPLoader",
        "match_strategy": "unique_class",
        "widget": "clip_name1"
      },
      "gguf_ckpt_name": {
        "class_type": "CheckpointLoaderGGUF",
        "match_strategy": "unique_class",
        "widget": "ckpt_name"
      },
      "gguf_unet_advanced_name": {
        "class_type": "UnetLoaderGGUFAdvanced",
        "match_strategy": "unique_class",
        "widget": "unet_name"
      },
      "gguf_unet_name": {
        "class_type": "UnetLoaderGGUF",
        "match_strategy": "unique_class",
        "widget": "unet_name"
      },
      "height": {
        "match_strategy": "output_connection",
        "target_class_type": "ModelSamplingFlux",
        "target_input": "height",
        "widget": "value"
      },
      "negative_prompt": {
        "class_type": "CLIPTextEncode",
        "match_strategy": "title_keyword",
        "title_keywords": [
          "negative",
          "负向"
        ],
        "widget": "text"
      },
      "nf4_ckpt_name": {
        "class_type": "CheckpointLoaderNF4",
        "match_strategy": "unique_class",
        "widget": "ckpt_name"
      },
      "nf4_unet_name": {
        "class_type": "UNETLoaderNF4",
        "match_strategy": "unique_class",
        "widget": "unet_name"
      },
      "nunchaku_model_name": {
        "class_type": "NunchakuQwenImageDiTLoader",
        "match_strategy": "unique_class",
        "widget": "model_name"
      },
      "positive_prompt": {
        "class_type": "CLIPTextEncode",
        "match_strategy": "title_keyword",
        "title_keywords": [
          "positive",
          "正向"
        ],
        "widget": "text"
      },
      "sampler": {
        "class_type": "KSamplerSelect",
        "match_strategy": "unique_class",
        "widget": "sampler_name"
      },
      "scheduler": {
        "class_type": "BasicScheduler",
        "match_strategy": "unique_class",
        "widget": "scheduler"
      },
      "seed": {
        "match_strategy": "output_connection",
        "target_class_type": "RandomNoise",
        "target_input": "noise_seed",
        "widget": "noise_seed"
      },
      "steps": {
        "class_type": "BasicScheduler",
        "match_strategy": "unique_class",
        "widget": "steps"
      },
      "unet_name": {
        "class_type": "UNETLoader",
        "match_strategy": "unique_class",
        "widget": "unet_name"
      },
      "vae_name": {
        "class_type": "VAELoader",
        "match_strategy": "unique_class",
        "widget": "vae_name"
      },
      "width": {
        "match_strategy": "output_connection",
        "target_class_type": "ModelSamplingFlux",
        "target_input": "width",
        "widget": "value"
      }
    }
  },
